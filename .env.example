# Copy to .env (git-ignored) or to ~/.config/confluence-md-sync/env.
# Variables already exported in your shell always win over these files.

CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
# This is a personal token: it carries your own rights, so `push` can only
# write to pages you can already edit.
CONFLUENCE_API_TOKEN=
